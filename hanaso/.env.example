# Hanaso の設定。このファイルを .env にコピーして使います (cp .env.example .env)

# Claude API キー (https://console.anthropic.com/ で発行)。未設定ならデモモードで起動します
ANTHROPIC_API_KEY=

# 使う Claude のモデル (既定: claude-opus-5-5)。
# 速さ・料金を優先するなら claude-sonnet-5-5 もおすすめ
# CLAUDE_MODEL=claude-opus-5-5

# 会話・添削・ヒント・翻訳の思考の深さ (low / medium / high)。低いほど速くて安い
# CLAUDE_EFFORT=low
# 振り返りの思考の深さ
# CLAUDE_SUMMARY_EFFORT=medium

# インターネットに公開するときは必ず合言葉を設定してください (API キーの不正利用防止)
# APP_PASSCODE=

# 強制的にデモモード (mock) / Claude (claude) にする
# AI_MODE=mock

# PORT=3000
